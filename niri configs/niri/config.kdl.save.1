layout {
    gaps 5
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    background-color "transparent"

    default-column-width { proportion 0.66667; }

    border {
        width 2
        active-gradient from="#189BCC" to="#189BCC" angle=90
        inactive-color "#BECC41"
    }
}

layer-rule {
    match namespace="^swww-daemon$"
    place-within-backdrop true
}

spawn-at-startup "/usr/bin/mate-polkit"
spawn-at-startup "systemctl" "--user" "enable" "--now" "hypridle"
spawn-at-startup "swww-daemon"
spawn-at-startup "swww restore"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup ".local/bin/ns.py"
